+//! Mandatory Buzz admission, enabled only by the native protected launcher.
+//! It sits below optional Goose hooks and never interprets a model as authority.
+use crate::config::GooseMode;
+use crate::conversation::message::Message;
+use crate::providers::base::*;
+use anyhow::{anyhow, bail, Result};
+use async_trait::async_trait;
+use goose_providers::{
+    errors::ProviderError, model::ModelConfig, permission::PermissionConfirmation,
+    retry::RetryConfig, thinking::ThinkingEffortSupport,
+};
+use rmcp::model::Tool;
+use serde_json::{json, Value};
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::watch;
+
+pub fn enabled() -> bool {
+    std::env::var_os("BUZZ_SECURITY_URL").is_some()
+}
+
+struct Bridge {
+    client: reqwest::Client,
+    url: String,
+    token: String,
+    session: String,
+}
+static BRIDGE: tokio::sync::OnceCell<Bridge> = tokio::sync::OnceCell::const_new();
+async fn bridge() -> Result<&'static Bridge> {
+    BRIDGE.get_or_try_init(||async {
+        let url=std::env::var("BUZZ_SECURITY_URL")?;
+        let parsed=reqwest::Url::parse(&url)?;
+        if parsed.scheme()!="http" || parsed.host_str()!=Some("127.0.0.1") {bail!("Invalid security bridge");}
+        let token=std::env::var("BUZZ_SECURITY_TOKEN")?;
+        let client=reqwest::Client::builder().no_proxy().redirect(reqwest::redirect::Policy::none()).timeout(Duration::from_secs(310)).build()?;
+        let id=uuid::Uuid::new_v4().to_string();
+        let response=client.post(&url).bearer_auth(&token).json(&json!({"jsonrpc":"2.0","id":id,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"buzz-security","version":"2"}}})).send().await?.error_for_status()?;
+        let session=response.headers().get("mcp-session-id").ok_or_else(||anyhow!("Security bridge did not establish a session"))?.to_str()?.to_string();
+        let reply:Value=serde_json::from_slice(&limited(response).await?)?;
+        if reply.get("id")!=Some(&json!(id)) || reply.get("result").and_then(|r|r.get("serverInfo")).and_then(|r|r.get("version"))!=Some(&json!("2")) {bail!("Invalid security bridge initialization");}
+        Ok(Bridge{client,url,token,session})
+    }).await
+}
+async fn limited(mut response: reqwest::Response) -> Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await? {
+        if bytes.len() + chunk.len() > 4096 {
+            bail!("Invalid security response");
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    Ok(bytes)
+}
+pub async fn check(kind: &str, session: &str, content: Value) -> Result<()> {
+    let phase = match kind {
+        "context" => "BUZZ_SECURITY_CONTEXT",
+        "tool" => "BUZZ_SECURITY_TOOL",
+        "tool-result" => "BUZZ_SECURITY_TOOL_RESULT",
+        _ => bail!("Unknown security phase"),
+    };
+    if !enabled() {
+        return Ok(());
+    }
+    // Disabled inspection sends no evidence, but still checks the live policy lease.
+    let content = if std::env::var(phase).as_deref() == Ok("0") {
+        Value::Null
+    } else {
+        content
+    };
+    let bridge = bridge().await?;
+    let id = uuid::Uuid::new_v4().to_string();
+    let body = json!({"jsonrpc":"2.0","id":id,"method":"buzz/security/check","params":{"kind":kind,"session":session,"content":content}});
+    if serde_json::to_vec(&body)?.len() > 262144 {
+        bail!(
+            "Security review context is too large: {} bytes (maximum 262144)",
+            serde_json::to_vec(&body)?.len()
+        );
+    }
+    let response = bridge
+        .client
+        .post(&bridge.url)
+        .bearer_auth(&bridge.token)
+        .header("mcp-session-id", &bridge.session)
+        .json(&body)
+        .send()
+        .await?
+        .error_for_status()?;
+    let reply: Value = serde_json::from_slice(&limited(response).await?)?;
+    if reply.get("id") != Some(&Value::String(id))
+        || reply.get("error").is_some()
+        || reply.get("result") != Some(&json!({"allowed":true}))
+    {
+        bail!("Buzz denied this security review");
+    }
+    Ok(())
+}
+
+pub async fn wrap(inner: Arc<dyn Provider>, session: &str) -> Result<Arc<dyn Provider>> {
+    if !enabled() {
+        return Ok(inner);
+    }
+    let entry = crate::providers::get_from_registry(inner.get_name()).await?;
+    if entry.runs_own_tool_loop() || inner.manages_own_context() {
+        bail!("This Goose provider runs tools outside the protected dispatcher");
+    }
+    Ok(Arc::new(ProtectedProvider {
+        inner,
+        session: session.to_string(),
+    }))
+}
+fn instruction_evidence(system: &str) -> &str {
+    // Only the exact compiled-in prefix is fixed harness text. Preserve unknown
+    // templates and every byte after it, including custom instructions and memory.
+    let Ok(prefix) = crate::agents::PromptManager::new().bundled_system_prompt() else {
+        return system;
+    };
+    system.strip_prefix(&prefix).unwrap_or(system)
+}
+
+struct ProtectedProvider {
+    inner: Arc<dyn Provider>,
+    session: String,
+}
+#[async_trait]
+impl Provider for ProtectedProvider {
+    fn get_name(&self) -> &str {
+        self.inner.get_name()
+    }
+    fn provider_session_id(&self) -> Option<String> {
+        self.inner.provider_session_id()
+    }
+    async fn resume(&self, _session_id: &str) -> Result<(), ProviderError> {
+        self.inner.resume(_session_id).await
+    }
+    async fn stream(
+        &self,
+        model_config: &ModelConfig,
+        system: &str,
+        messages: &[Message],
+        tools: &[Tool],
+    ) -> Result<MessageStream, ProviderError> {
+        // Inspect each native source before dispatch, rather than classifying
+        // model configuration and the tool catalogue as one conversation blob.
+        check(
+            "context",
+            &self.session,
+            json!({"source":"instructions","value":instruction_evidence(system)}),
+        )
+        .await
+        .map_err(|e| ProviderError::ExecutionError(e.to_string()))?;
+        for message in messages {
+            check(
+                "context",
+                &self.session,
+                json!({"source":"message","value":message}),
+            )
+            .await
+            .map_err(|e| ProviderError::ExecutionError(e.to_string()))?;
+        }
+        self.inner
+            .stream(model_config, system, messages, tools)
+            .await
+    }
+    async fn complete(
+        &self,
+        model_config: &ModelConfig,
+        system: &str,
+        messages: &[Message],
+        tools: &[Tool],
+    ) -> Result<(Message, ProviderUsage), ProviderError> {
+        // Inspect each native source before dispatch, rather than classifying
+        // model configuration and the tool catalogue as one conversation blob.
+        check(
+            "context",
+            &self.session,
+            json!({"source":"instructions","value":instruction_evidence(system)}),
+        )
+        .await
+        .map_err(|e| ProviderError::ExecutionError(e.to_string()))?;
+        for message in messages {
+            check(
+                "context",
+                &self.session,
+                json!({"source":"message","value":message}),
+            )
+            .await
+            .map_err(|e| ProviderError::ExecutionError(e.to_string()))?;
+        }
+        self.inner
+            .complete(model_config, system, messages, tools)
+            .await
+    }
+    async fn get_context_limit(&self, model: &str, override_limit: Option<usize>) -> usize {
+        self.inner.get_context_limit(model, override_limit).await
+    }
+    fn retry_config(&self) -> RetryConfig {
+        self.inner.retry_config()
+    }
+    async fn fetch_supported_models(&self) -> Result<Vec<String>, ProviderError> {
+        self.inner.fetch_supported_models().await
+    }
+    async fn fetch_supported_model_info(&self) -> Result<Vec<ModelInfo>, ProviderError> {
+        self.inner.fetch_supported_model_info().await
+    }
+    async fn fetch_model_info(&self, model_name: &str) -> Result<ModelInfo, ProviderError> {
+        self.inner.fetch_model_info(model_name).await
+    }
+    fn skip_canonical_filtering(&self) -> bool {
+        self.inner.skip_canonical_filtering()
+    }
+    async fn fetch_recommended_models(&self, toolshim: bool) -> Result<Vec<String>, ProviderError> {
+        self.inner.fetch_recommended_models(toolshim).await
+    }
+    async fn fetch_recommended_model_info(
+        &self,
+        toolshim: bool,
+    ) -> Result<Vec<ModelInfo>, ProviderError> {
+        self.inner.fetch_recommended_model_info(toolshim).await
+    }
+    async fn map_to_canonical_model(
+        &self,
+        provider_model: &str,
+    ) -> Result<Option<String>, ProviderError> {
+        self.inner.map_to_canonical_model(provider_model).await
+    }
+    fn manages_own_context(&self) -> bool {
+        self.inner.manages_own_context()
+    }
+    fn uses_local_session_naming(&self) -> bool {
+        self.inner.uses_local_session_naming()
+    }
+    fn supports_builtin_tools(&self) -> bool {
+        self.inner.supports_builtin_tools()
+    }
+    async fn configure_oauth(&self) -> Result<(), ProviderError> {
+        self.inner.configure_oauth().await
+    }
+    async fn refresh_credentials(&self) -> Result<(), ProviderError> {
+        self.inner.refresh_credentials().await
+    }
+    async fn update_mode(&self, _session_id: &str, _mode: GooseMode) -> Result<(), ProviderError> {
+        self.inner.update_mode(_session_id, _mode).await
+    }
+    fn thinking_effort_support(&self) -> ThinkingEffortSupport {
+        self.inner.thinking_effort_support()
+    }
+    fn subscribe_thinking_effort_support(&self) -> Option<watch::Receiver<ThinkingEffortSupport>> {
+        self.inner.subscribe_thinking_effort_support()
+    }
+    async fn set_thinking_effort(
+        &self,
+        _session_id: &str,
+        _value: &str,
+    ) -> Result<bool, ProviderError> {
+        self.inner.set_thinking_effort(_session_id, _value).await
+    }
+    async fn apply_model_selection(
+        &self,
+        _model_config: &ModelConfig,
+    ) -> Result<(), ProviderError> {
+        self.inner.apply_model_selection(_model_config).await
+    }
+    fn permission_routing(&self) -> PermissionRouting {
+        self.inner.permission_routing()
+    }
+    async fn handle_permission_confirmation(
+        &self,
+        _request_id: &str,
+        _confirmation: &PermissionConfirmation,
+    ) -> bool {
+        self.inner
+            .handle_permission_confirmation(_request_id, _confirmation)
+            .await
+    }
+}
+
+/// A short-lived setup worker; no agent/session/extensions or tools are created.
+pub async fn review(params: Value) -> Result<Value> {
+    if enabled() {
+        bail!("Review inference is forbidden inside requesting workers");
+    }
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct ReviewPrompt {
+        system: String,
+        input: String,
+    }
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Review {
+        provider: Option<String>,
+        id: String,
+        prompt: ReviewPrompt,
+    }
+    let request: Review = serde_json::from_value(params)?;
+    if request.prompt.system.is_empty()
+        || request.prompt.input.is_empty()
+        || request.prompt.system.len() + request.prompt.input.len() > 786432
+    {
+        bail!("Invalid review prompt");
+    }
+    let config = crate::config::Config::global();
+    let explicit_provider = request
+        .provider
+        .as_ref()
+        .is_some_and(|value| !value.is_empty());
+    let name = request
+        .provider
+        .filter(|s| !s.is_empty())
+        .map(Ok)
+        .unwrap_or_else(|| config.get_goose_provider())?;
+    let entry = crate::providers::get_from_registry(&name).await?;
+    if entry.runs_own_tool_loop() {
+        bail!("This review provider does not offer tool-less inference");
+    }
+    let id = if request.id.is_empty() {
+        if explicit_provider {
+            entry.metadata().default_model.clone()
+        } else {
+            config.get_goose_model()?
+        }
+    } else {
+        request.id
+    };
+    let model = entry.normalize_model_config(
+        crate::model_config::model_config_from_user_config(&name, &id)?,
+    )?;
+    if model.toolshim {
+        bail!("Review inference does not support toolshim");
+    }
+    let provider = entry.create(Vec::new()).await?;
+    if provider.manages_own_context() {
+        bail!("Review inference requires a tool-less provider");
+    }
+    let (reply, _) = tokio::time::timeout(
+        Duration::from_secs(60),
+        provider.complete(
+            &model,
+            &request.prompt.system,
+            &[Message::user().with_text(request.prompt.input)],
+            &[],
+        ),
+    )
+    .await??;
+    Ok(json!({"text":reply.as_concat_text(),"model":{"provider":name,"id":model.model_name}}))
+}
