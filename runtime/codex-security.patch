+//! Buzz's mandatory native model and tool admission channel.
+use anyhow::{Result, anyhow, bail};
+use serde_json::{Value, json};
+use std::time::Duration;
+pub fn enabled() -> bool {
+    std::env::var_os("BUZZ_SECURITY_URL").is_some()
+}
+
+struct Bridge {
+    client: reqwest::Client,
+    url: String,
+    token: String,
+    session: String,
+}
+static BRIDGE: tokio::sync::OnceCell<Bridge> = tokio::sync::OnceCell::const_new();
+async fn bridge() -> Result<&'static Bridge> {
+    BRIDGE.get_or_try_init(||async {
+        let url=std::env::var("BUZZ_SECURITY_URL")?;
+        let parsed=reqwest::Url::parse(&url)?;
+        if parsed.scheme()!="http" || parsed.host_str()!=Some("127.0.0.1") {bail!("Invalid security bridge");}
+        let token=std::env::var("BUZZ_SECURITY_TOKEN")?;
+        let client=reqwest::Client::builder().no_proxy().redirect(reqwest::redirect::Policy::none()).timeout(Duration::from_secs(310)).build()?;
+        let id=uuid::Uuid::new_v4().to_string();
+        let response=client.post(&url).bearer_auth(&token).json(&json!({"jsonrpc":"2.0","id":id,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"buzz-security","version":"2"}}})).send().await?.error_for_status()?;
+        let session=response.headers().get("mcp-session-id").ok_or_else(||anyhow!("Security bridge did not establish a session"))?.to_str()?.to_string();
+        let reply:Value=serde_json::from_slice(&limited(response).await?)?;
+        if reply.get("id")!=Some(&json!(id)) || reply.get("result").and_then(|r|r.get("serverInfo")).and_then(|r|r.get("version"))!=Some(&json!("2")) {bail!("Invalid security bridge initialization");}
+        Ok(Bridge{client,url,token,session})
+    }).await
+}
+async fn limited(mut response: reqwest::Response) -> Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await? {
+        if bytes.len() + chunk.len() > 4096 {
+            bail!("Invalid security response");
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    Ok(bytes)
+}
+pub async fn check(kind: &str, session: &str, content: Value) -> Result<()> {
+    let phase = match kind {
+        "context" => "BUZZ_SECURITY_CONTEXT",
+        "tool" => "BUZZ_SECURITY_TOOL",
+        "tool-result" => "BUZZ_SECURITY_TOOL_RESULT",
+        _ => bail!("Unknown security phase"),
+    };
+    if !enabled() {
+        return Ok(());
+    }
+    // Disabled inspection sends no evidence, but still checks the live policy lease.
+    let content = if std::env::var(phase).as_deref() == Ok("0") {
+        Value::Null
+    } else {
+        content
+    };
+    let bridge = bridge().await?;
+    let id = uuid::Uuid::new_v4().to_string();
+    let body = json!({"jsonrpc":"2.0","id":id,"method":"buzz/security/check","params":{"kind":kind,"session":session,"content":content}});
+    if serde_json::to_vec(&body)?.len() > 262144 {
+        bail!("Security review context is too large: {} bytes (maximum 262144)", serde_json::to_vec(&body)?.len());
+    }
+    let response = bridge
+        .client
+        .post(&bridge.url)
+        .bearer_auth(&bridge.token)
+        .header("mcp-session-id", &bridge.session)
+        .json(&body)
+        .send()
+        .await?
+        .error_for_status()?;
+    let reply: Value = serde_json::from_slice(&limited(response).await?)?;
+    if reply.get("id") != Some(&Value::String(id))
+        || reply.get("error").is_some()
+        || reply.get("result") != Some(&json!({"allowed":true}))
+    {
+        bail!("Buzz denied this security review");
+    }
+    Ok(())
+}
+
+pub fn review_only() -> bool {
+    std::env::var_os("BUZZ_SECURITY_REVIEW_ONLY").is_some()
+}
+
+pub async fn model(session: &str, request: Value) -> Result<()> {
+    if !enabled() {
+        return Ok(());
+    }
+    // Hosted tools execute outside the local dispatcher and cannot be admitted.
+    fn local(tool: &Value) -> bool {
+        match tool.get("type").and_then(Value::as_str) {
+            Some("function" | "custom") => true,
+            Some("namespace") => tool
+                .get("tools")
+                .and_then(Value::as_array)
+                .is_some_and(|tools| tools.iter().all(local)),
+            Some("tool_search") => tool.get("execution").and_then(Value::as_str) == Some("client"),
+            _ => false,
+        }
+    }
+    if !request.get("tools").is_none_or(|tools| {
+        tools.is_null()
+            || tools
+                .as_array()
+                .is_some_and(|tools| tools.iter().all(local))
+    }) {
+        bail!("Protected Codex requires all tools to use local dispatch");
+    }
+    check("context", session, request).await
+}
+
+pub async fn tool(invocation: &crate::tools::context::ToolInvocation) -> Result<()> {
+    if review_only() {
+        bail!("Security reviewer processes cannot execute tools");
+    }
+    if !enabled() {
+        return Ok(());
+    }
+    let payload = match &invocation.payload {
+        crate::tools::context::ToolPayload::Function { arguments } => {
+            json!({"type":"function","arguments":arguments})
+        }
+        crate::tools::context::ToolPayload::Custom { input } => {
+            json!({"type":"custom","input":input})
+        }
+        crate::tools::context::ToolPayload::ToolSearch { arguments } => {
+            json!({"type":"tool_search","arguments":arguments})
+        }
+    };
+    let history = invocation.session.conversation_history_snapshot().await;
+    let context: Vec<_> = history.review_items().collect();
+    let origin = invocation.originating_call().await;
+    let evidence = json!({"title":invocation.tool_name.to_string(),"arguments":payload,"callId":invocation.call_id,"conversation":context,"originatingItem":origin.as_ref().and_then(|o|o.item_id.as_ref()),"originatingWindow":origin.as_ref().map(|o|&o.window_id)});
+    tokio::select! {
+        biased;
+        _=invocation.cancellation_token.cancelled()=>bail!("Security review cancelled"),
