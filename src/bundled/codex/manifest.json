{
  "id": "buzz.codex",
  "name": "Codex",
  "apiVersion": 1,
  "description": "Run local Codex coding agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "mcp": true,
    "networkOrigins": ["https://releases.openai.com"],
    "files": true,
    "processes": [
      {
        "id": "protected-app-server",
        "program": "codex-app-server-protected",
        "bundled": true
      },
      {
        "id": "workspace",
        "program": "pwd"
      },
      {
        "id": "codex-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      }
    ]
  }
}
